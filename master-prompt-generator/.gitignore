# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Environment & secrets
# Ignore every .env variant and name the two that are meant to be committed.
# Listing .env and .env.local individually is what let .env.backup -- an
# obvious name for a copy of a populated .env -- get committed.
.env*
!.env.example
!.env.local.example
*.pem

# Runtime artefacts
backend/config/models.json.tmp
# Default SQLITE_DIRECTORY: a run's database, never part of the source tree.
backend/data/
*.log
.DS_Store
