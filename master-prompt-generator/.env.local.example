# ===================================================================
#  Fully open-source stack — no API keys, no per-token cost.
#
#  Copy to .env, then start with:
#      docker compose --profile local up --build
#  or on Windows:
#      run-mpg.bat local
#
#  Everything runs on open-weight models served by Ollama on your own
#  hardware. The first start downloads roughly 12 GB of weights.
# ===================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Use the open-source model registry ---
# Path is inside the backend container; ./backend/config is mounted there.
MODEL_CONFIG_PATH=/srv/config/models.local.json
OLLAMA_BASE_URL=http://ollama:11434

# The three pipeline agents must reference ids that exist in models.local.json.
ANALYZER_MODEL_ID=ollama-qwen25
JUDGE_MODEL_ID=ollama-qwen25
CONSENSUS_MODEL_ID=ollama-llama31

# --- Local embeddings for semantic search ---
# nomic-embed-text is 768-dimensional, not 1536. Changing the width means the
# Qdrant collection must be recreated: docker compose down -v, or drop the
# mpg_prompts collection.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Weights to pull on first start ---
OLLAMA_MODELS=qwen2.5:7b-instruct llama3.1:8b-instruct-q4_K_M mistral:7b-instruct nomic-embed-text

# --- Timing ---
# Local inference is far slower than a hosted API. On CPU a 7B model can take
# minutes per prompt, so the timeouts are generous and the fan-out is
# serialised: Ollama answers one request at a time by default, and running
# three in parallel against it just makes all three time out together.
GENERATION_TIMEOUT_SECONDS=900
JUDGE_TIMEOUT_SECONDS=900
MAX_PARALLEL_GENERATIONS=1
CELERY_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=15m

# CPU-only machine? Swap the registry to smaller weights — quality drops but a
# run finishes in minutes rather than tens of minutes:
#   OLLAMA_MODELS=qwen2.5:3b-instruct llama3.2:3b-instruct-q4_K_M nomic-embed-text
# and edit backend/config/models.local.json to match the tags.
#
# GPU? Add a deploy.resources block to the ollama service and raise
# OLLAMA_NUM_PARALLEL / MAX_PARALLEL_GENERATIONS to fan out for real.

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-this-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Infrastructure ---
POSTGRES_USER=mpg
# Generated per-install by run-mpg.bat; change it for any shared deployment.
POSTGRES_PASSWORD=mpg
POSTGRES_DB=mpg
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
BACKEND_PORT=8000
# Interface the infrastructure ports bind to. Leave as loopback unless you
# have deliberately firewalled the host.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
OLLAMA_PORT=11434

# --- Optional: hosted gateways that serve open-weight models ---
# Free tiers, still open models, and far faster than local CPU. Set a key here
# and enable the matching entry in backend/config/models.local.json.
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
