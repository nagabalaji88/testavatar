# Copy to .env and fill in before `docker compose up`.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Provider credentials (at least one is required) ---
# No keys? Use the free open-source stack instead: copy .env.local.example
# over this file and run `docker compose --profile local up` (or run-mpg.bat
# local). It runs entirely on open-weight models via Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Hosted gateways that serve open-weight models (free tiers available).
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-this-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Infrastructure ---
POSTGRES_USER=mpg
POSTGRES_PASSWORD=mpg
POSTGRES_DB=mpg
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
BACKEND_PORT=8000
FRONTEND_PORT=8080
CELERY_CONCURRENCY=4

# --- Observability (optional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
