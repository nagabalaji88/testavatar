# Copy to .env and fill in before `docker compose up`.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Provider credentials (at least one is required) ---
# No keys? Use the free open-source stack instead: copy .env.local.example
# over this file and run `docker compose --profile local up` (or run-mpg.bat
# local). It runs entirely on open-weight models via Ollama.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Hosted gateways that serve open-weight models (free tiers available).
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Hosted deployments of open-weight models, keyed per registry entry rather
# than per provider family. A models.json entry names the variable it reads
# via "api_key_env", so the key stays in this file -- which is gitignored --
# instead of models.json, which is committed.
OLLAMA_CLOUD_API_KEY=

# Which registry entry serves each pipeline role. Point all three at a model
# you hold a key for; a role left pointing at an uncredentialed entry falls
# back to the deterministic path (analyzer) or fails its call (judge,
# consensus), which is the usual cause of a run that "completes" with a
# noticeably worse prompt than the fan-out produced.
ANALYZER_MODEL_ID=openai-gpt4o
JUDGE_MODEL_ID=anthropic-claude-sonnet
CONSENSUS_MODEL_ID=anthropic-claude-sonnet

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-this-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Anyone who can reach the service can create an account while this is true,
# and the first account created becomes admin. Leave it on to bootstrap, then
# set it to false -- ENVIRONMENT=staging or production refuses to start
# otherwise. Registering your own admin account first is the whole procedure.
ALLOW_OPEN_REGISTRATION=true

# --- Infrastructure ---
POSTGRES_USER=mpg
# Generated per-install by run-mpg.bat; change it for any shared deployment.
POSTGRES_PASSWORD=mpg
POSTGRES_DB=mpg
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
BACKEND_PORT=8000
# Interface the infrastructure ports bind to. Leave as loopback unless you
# have deliberately firewalled the host.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
CELERY_CONCURRENCY=4

# --- Observability (optional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Compare directives by meaning rather than shared words when merging prompts.
# Costs one batched embedding call per run (fractions of a cent) and needs a
# working embedding provider. Off by default; the merge falls back to the
# lexical comparison both when this is false and when embedding fails.
SEMANTIC_MERGE_ENABLED=false
